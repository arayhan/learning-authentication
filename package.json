{
  "name": "auth-academy",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter academy dev",
    "lab": "node scripts/lab.mjs",
    "contract": "node scripts/contract.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test": "pnpm run test:scripts && pnpm -r --if-present test",
    "db:up": "docker compose up -d",
    "shots": "pnpm --filter academy exec tsx ../../scripts/shots.ts"
  }
}
